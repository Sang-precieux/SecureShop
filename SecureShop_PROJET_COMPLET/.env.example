# Le programme INSTALLER_WINDOWS.bat crée les deux clés ci-dessous dans .env.
DJANGO_SECRET_KEY=
PAYMENT_HMAC_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Facultatif : renseigner les deux paramètres pour envoyer les OTP avec Gmail.
# Si laissés vides : OTP affiché dans le terminal local (mode démonstration).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
